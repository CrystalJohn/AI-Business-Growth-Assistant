# ─── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=bizgrowth
POSTGRES_PORT=5432

# ─── Backend API ───────────────────────────────────────────
DATABASE_URL=postgresql://admin:password@localhost:5432/bizgrowth
LLM_PROVIDER=mock
CORS_ORIGINS=http://localhost:3000

# ─── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Security (Week 2+) ────────────────────────────────────
JWT_SECRET=change-me-in-production
PII_MASKING_KEY=change-me-masking-key

# ─── LLM (Week 4) ──────────────────────────────────────────
# Get Gemini key: https://aistudio.google.com/apikey
# Get Groq key:   https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_TIMEOUT_SECONDS=10
LLM_CACHE_TTL_SECONDS=3600
